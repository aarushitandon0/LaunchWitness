# QUICK LOCAL mode: plain HTTP on port 80, any host name. Signing in needs DEV_MODE=true here (no https).
# For the production-like local stack (HTTPS, real cookies) use docker-compose.local.yml: deploy/README.md.
# Prod mode is deploy/Caddyfile.prod (select with CADDYFILE=Caddyfile.prod).

:80 {
	# Internal endpoints are for Caddy <-> app only, never public.
	@internal path /internal /internal/*
	respond @internal 404

	reverse_proxy app:8000
}
