# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- App ---
APP_DOMAIN=localhost              # on the VPS: launchwitness.com
APP_BASE_URL=http://localhost     # on the VPS: https://launchwitness.com
APP_ORIGIN=                      # scheme://host of the app for CSRF checks; empty = taken from APP_BASE_URL
ADMIN_EMAIL=                     # this address is the admin (signs in by email link like everyone); fill on the server
DEV_MODE=false                   # LOCAL ONLY: http cookies + sign-in link shown on screen. Refuses to start on https.
# Local dev with `npm run dev` (Vite on :5173): the dev proxy presents LW_APP_ORIGIN (shell env, default
# http://localhost) as the Origin, so set APP_BASE_URL to match. Never loosen APP_ORIGIN on the server.
SESSION_DAYS=14
SIGNIN_LINKS_PER_EMAIL_PER_DAY=5
SIGNIN_LINKS_PER_IP_PER_HOUR=10
MAX_SHOPS_PER_USER=3
USER_DESCRIBES_PER_DAY=5         # per-user daily Claude cap (each describe = one Claude call)
MAX_LIVE_SHOPS=40                # certificate limit: about 50 new certificates a week per domain
SHOP_REPORTS_PER_VISITOR_PER_DAY=3
ADDRESS_CHECKS_PER_HOUR=10       # public "Check any address" (read-only), per visitor
ADDRESS_CHECKS_PER_DAY=500       # ... and for everyone together
MAILBOX_EXPIRES_ON=              # YYYY-MM-DD when hello@ lapses (about 2026-12-15); /api/health warns 14 days ahead
# Emergency / command-line admin only (X-Admin-Token header); people use ADMIN_EMAIL
ADMIN_TOKEN=change-me            # admin-only routes (demo fault, real launches). Admin is OFF until set to 16+ random chars
SERVER_IP=127.0.0.1              # public IP of the VPS (seller A records point here)
USE_FAKES=true                   # true = practice mode: GoDaddy/DNS/mailbox/HTTP are in-memory fakes
DNS_MODE=per_shop                # per_shop = one address record per shop, written by the app | wildcard = you made *.APP_DOMAIN by hand, the app writes no DNS
PRACTICE_STEP_SECONDS=0          # pretend world only: pause before each launch step (demos; restart test). 0 = none
VISITOR_DESCRIBES_PER_DAY=5      # per visitor (IP) per day; admin exempt
VISITOR_LAUNCHES_PER_DAY=3
ORDERS_PER_VISITOR_PER_HOUR=5    # order form: per visitor, per shop, per hour
ORDERS_PER_SHOP_PER_DAY=200      # order form: per shop per day (test orders don't count)
VISITOR_CONTACTS_PER_DAY=5       # landing-page contact form messages per visitor per day
MONITOR_ENABLED=true             # light monitoring scheduler (every 15 min + daily)

# --- Claude API ($100 budget, product only) ---
ANTHROPIC_API_KEY=
CLAUDE_MODE=fixture              # fixture | live
CLAUDE_MODEL_STRONG=claude-sonnet-5-5   # Reader only
CLAUDE_MODEL_CHEAP=claude-haiku-5-5     # Namer, Doctor
CLAUDE_MAX_TOKENS=1500
CLAUDE_DAILY_SPEND_CAP_USD=3

# --- GoDaddy ---
GODADDY_ENV=ote                  # ote | prod
GODADDY_API_KEY=
GODADDY_API_SECRET=
GODADDY_OTE_API_KEY=
GODADDY_OTE_API_SECRET=

# --- Spend guards (do not change defaults casually) ---
ALLOW_PURCHASE=false
MAX_SPEND_USD=15
EMAIL_PLAN_ESTIMATE_USD=23.88    # per year, approval card only. Pro Light on a 1-yr term ($1.99/mo); monthly term is $5.99/mo

# --- Mail (app mailbox: GoDaddy Professional Email, secureserver.net) ---
MAIL_PROVIDER=secureserver       # secureserver (GoDaddy Professional Email) | titan
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465                    # SSL; the app falls back to 587 STARTTLS if 465 is unreachable
SMTP_SECURITY=ssl                # ssl | starttls | plain (plain: local catch-all only, e.g. mailpit; refused for real hosts)
SMTP_USER=hello@launchwitness.com   # full address
SMTP_PASSWORD=                   # mailbox password: put it in .env only, never in code, tests or logs
IMAP_HOST=imap.secureserver.net
IMAP_PORT=993
IMAP_USER=hello@launchwitness.com
IMAP_PASSWORD=

# --- Database ---
DATABASE_URL=sqlite:///./data/launchwitness.db

# --- Deploy (read by docker compose, not by the app) ---
CADDYFILE=Caddyfile              # Caddyfile (local, http://localhost) | Caddyfile.prod (HTTPS + on-demand TLS)
