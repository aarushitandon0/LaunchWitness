# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- App ---
APP_DOMAIN=localhost
APP_BASE_URL=http://localhost
ADMIN_TOKEN=change-me            # admin-only routes (demo fault, real launches). Admin is OFF until set to 16+ random chars
SERVER_IP=127.0.0.1              # public IP of the VPS (seller A records point here)
USE_FAKES=true                   # true = practice mode: GoDaddy/DNS/mailbox/HTTP are in-memory fakes
VISITOR_DESCRIBES_PER_DAY=5      # per visitor (IP) per day; admin exempt
VISITOR_LAUNCHES_PER_DAY=3
VISITOR_CONTACTS_PER_DAY=5       # landing-page contact form messages per visitor per day
MONITOR_ENABLED=true             # light monitoring scheduler (every 15 min + daily)

# --- Claude API ($100 budget, product only) ---
ANTHROPIC_API_KEY=
CLAUDE_MODE=fixture              # fixture | live
CLAUDE_MODEL_STRONG=claude-sonnet-5-5   # Reader only
CLAUDE_MODEL_CHEAP=claude-haiku-5-5     # Namer, Doctor
CLAUDE_MAX_TOKENS=1500
CLAUDE_DAILY_SPEND_CAP_USD=3

# --- GoDaddy ---
GODADDY_ENV=ote                  # ote | prod
GODADDY_API_KEY=
GODADDY_API_SECRET=
GODADDY_OTE_API_KEY=
GODADDY_OTE_API_SECRET=

# --- Spend guards (do not change defaults casually) ---
ALLOW_PURCHASE=false
MAX_SPEND_USD=15
EMAIL_PLAN_ESTIMATE_USD=24       # per year, shown on the approval card only (placeholder: check the real cart)

# --- Mail (app's one Titan mailbox) ---
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=hello@example.com      # full address
SMTP_PASSWORD=
IMAP_HOST=imap.secureserver.net
IMAP_PORT=993
IMAP_USER=hello@example.com
IMAP_PASSWORD=

# --- Database ---
DATABASE_URL=sqlite:///./data/launchwitness.db

# --- Deploy (read by docker compose, not by the app) ---
CADDYFILE=Caddyfile              # Caddyfile (local, http://localhost) | Caddyfile.prod (HTTPS + on-demand TLS)
